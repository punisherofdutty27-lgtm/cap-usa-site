# Redirections canoniques : http -> https et www -> domaine nu, en UN seul saut 301.
# Les règles ne testent aucun fichier : les URL sans extension (MultiViews) ne sont pas affectées.
# La chaîne de requête (?utm_...) est conservée automatiquement par mod_rewrite (pas de flag QSD).
#
# ACTIF pour tous les visiteurs (le mode test ?__rt=1 a été retiré après validation sur OVH).
# Retour arrière rapide : commenter les 2 blocs RewriteCond/RewriteRule ci-dessous (ou redéployer le tag pre-redirects-8f52f67).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) hellocapusa.com / www sans HTTPS -> https://hellocapusa.com. Trois indices de HTTPS sont testés pour éviter toute
  #    boucle derrière un proxy OVH : variable HTTPS, en-tête X-Forwarded-Proto et port 443.
  # Restriction d'hôte : uniquement les domaines officiels (aucun drapeau OR : toutes les conditions de cette règle sont cumulatives).
  RewriteCond %{HTTP_HOST} ^(www\.)?hellocapusa\.com(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://hellocapusa.com%{REQUEST_URI} [L,R=301]

  # 2) www -> domaine nu
  RewriteCond %{HTTP_HOST} ^www\.hellocapusa\.com$ [NC]
  RewriteRule ^ https://hellocapusa.com%{REQUEST_URI} [L,R=301]

  # 3) /blog (sans extension, servi par MultiViews) -> URL canonique /blog.html. Le test porte sur la ligne de requête
  #    d'origine (THE_REQUEST), donc indépendant de MultiViews ; pas de boucle : /blog.html ne correspond pas au motif.
  #    /index.html n'est volontairement PAS redirigé : de nombreux liens internes y pointent (index.html#diagnostic, etc.).
  RewriteCond %{HTTP_HOST} ^hellocapusa\.com$ [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog(\?[^\ ]*)?\ HTTP/
  RewriteRule ^ https://hellocapusa.com/blog.html [L,R=301]

  # 4) Ancienne adresse de la landing page Google Ads (devenue l'accueil) -> https://hellocapusa.com/ en 301. La chaîne de requête
  #    (?utm_..., gclid) est conservée automatiquement par mod_rewrite. Test sur THE_REQUEST (indépendant de MultiViews) ; pas de boucle.
  RewriteCond %{HTTP_HOST} ^hellocapusa\.com$ [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /creer-llc-visa-e2-usa(\.html)?(\?[^\ ]*)?\ HTTP/
  RewriteRule ^ https://hellocapusa.com/ [L,R=301]
</IfModule>

# Cache statique — assets sans versioning d'URL, pas de "immutable" pour rester
# safe en cas de remplacement d'un fichier au meme nom.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/pdf "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

# Polices hébergées : type MIME explicite.
AddType font/woff2 .woff2

# Page 404 personnalisée (le code HTTP reste 404, la page est en noindex).
ErrorDocument 404 /404.html

# En-têtes de sécurité (sans CSP : Calendly, Formspree et Google sont des services tiers à tester séparément).
# HSTS : 1 an, sans includeSubDomains ni preload (aucun sous-domaine concerné pour l'instant).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|mp4|pdf|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
